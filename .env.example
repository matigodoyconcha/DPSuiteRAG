# HuggingFace token para descargas más rápidas
# Obten tu token en: https://huggingface.co/settings/tokens
HF_TOKEN=tu_token_aqui

# GPUs disponibles para los experimentos (PyTorch/CUDA)
# Ejemplos:
#   CUDA_VISIBLE_DEVICES=0          → usar solo GPU 0
#   CUDA_VISIBLE_DEVICES=1          → usar solo GPU 1
#   CUDA_VISIBLE_DEVICES=0,1        → GPUs 0 y 1 (device_map="auto" las reparte)
#   CUDA_VISIBLE_DEVICES=0,1,2      → las 3 GPUs disponibles
#   CUDA_VISIBLE_DEVICES=           → deshabilitar CUDA (forzar CPU/MPS)
# Si no se define, se usa la primera GPU disponible (o MPS en Apple Silicon).
# CUDA_VISIBLE_DEVICES=0
