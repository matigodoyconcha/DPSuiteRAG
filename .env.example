# HuggingFace token for faster downloads
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_token_here

# GPUs available for the experiments (PyTorch/CUDA)
# Examples:
#   CUDA_VISIBLE_DEVICES=0          → use only GPU 0
#   CUDA_VISIBLE_DEVICES=1          → use only GPU 1
#   CUDA_VISIBLE_DEVICES=0,1        → GPUs 0 and 1 (device_map="auto" splits across them)
#   CUDA_VISIBLE_DEVICES=0,1,2      → all 3 available GPUs
#   CUDA_VISIBLE_DEVICES=           → disable CUDA (force CPU/MPS)
# If unset, the first available GPU is used (or MPS on Apple Silicon).
# CUDA_VISIBLE_DEVICES=0
